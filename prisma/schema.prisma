generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ingredient {
  id       Int                @id @default(autoincrement())
  slug     String             @unique
  name     String
  /// Estonian name (English is in `name`)
  nameEt   String             @default("")
  isStaple Boolean            @default(false)
  recipes  RecipeIngredient[]
}

model Recipe {
  id              Int                @id @default(autoincrement())
  slug            String             @unique
  name            String
  /// Estonian name (English is in `name`)
  nameEt          String             @default("")
  category        String
  prepTimeMinutes Int
  steps           String[]
  /// Estonian steps (English are in `steps`)
  stepsEt         String[]           @default([])
  imageUrl        String?
  ingredients     RecipeIngredient[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([category])
}

model RecipeIngredient {
  recipeId     Int
  ingredientId Int
  quantity     String
  /// Estonian quantity (English is in `quantity`)
  quantityEt   String     @default("")
  position     Int
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([recipeId, ingredientId])
  @@index([ingredientId])
}
